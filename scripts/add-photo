#!/usr/bin/env ruby
# frozen_string_literal: true

# Adds a photograph to the website: compresses it into a web-sized JPEG under
# assets/images/photography/ and appends an entry, with its EXIF data, to
# _data/photography.yml (see the comment at the top of that file for the fields).
#
#   scripts/add-photo IMG_0042.heic -a "A tram in front of the cathedral" -l "Milan, Italy"
#
# Reads JPEG, TIFF and HEIC. Needs `sips` (macOS) or ImageMagick (`magick`) to decode and
# resize; the EXIF data is read by this script, so exiftool is not needed.

require 'date'
require 'fileutils'
require 'json'
require 'net/http'
require 'shellwords'
require 'optparse'
require 'tempfile'
require 'time'
require 'yaml'

ROOT = File.expand_path('..', __dir__)
DATA_FILE = File.join(ROOT, '_data', 'photography.yml')
PHOTO_DIR = File.join('assets', 'images', 'photography')
INPUT_FORMATS = %w[.jpg .jpeg .tif .tiff .heic .heif].freeze

# Reads the few EXIF tags the photography page shows, from a JPEG or a TIFF file.
module Exif
  TYPE_SIZES = { 1 => 1, 2 => 1, 3 => 2, 4 => 4, 5 => 8, 7 => 1, 9 => 4, 10 => 8 }.freeze
  IFD0_TAGS = { 0x010F => :make, 0x0110 => :model, 0x0112 => :orientation, 0x8769 => :exif_ifd, 0x8825 => :gps_ifd }.freeze
  GPS_TAGS = { 1 => :lat_ref, 2 => :lat, 3 => :lon_ref, 4 => :lon }.freeze
  EXIF_TAGS = {
    0x829A => :exposure_time, 0x829D => :f_number, 0x8827 => :iso, 0x9003 => :date_time,
    0x920A => :focal_length, 0xA434 => :lens
  }.freeze

  module_function

  def read(path)
    data = File.binread(path)
    tiff = if data.start_with?("\xFF\xD8".b)
             jpeg_exif(data)
           elsif data.start_with?('II*'.b + "\0".b) || data.start_with?("MM\0*".b)
             data
           end
    tiff ? parse(tiff) : {}
  rescue StandardError
    {}
  end

  # The TIFF structure inside the "Exif" APP1 segment of a JPEG
  def jpeg_exif(data)
    pos = 2
    while pos + 4 <= data.bytesize && data.getbyte(pos) == 0xFF
      marker = data.getbyte(pos + 1)
      break if marker == 0xDA # start of scan: no metadata after this

      length = data.byteslice(pos + 2, 2).unpack1('n')
      payload = data.byteslice(pos + 4, length - 2)
      return payload.byteslice(6..) if marker == 0xE1 && payload.start_with?("Exif\0\0".b)

      pos += 2 + length
    end
    nil
  end

  def parse(tiff)
    endian = tiff.start_with?('II') ? :little : :big
    u16 = endian == :little ? 'v' : 'n'
    u32 = endian == :little ? 'V' : 'N'
    s32 = endian == :little ? 'l<' : 'l>'

    read_ifd = lambda do |offset, tags|
      count = tiff.byteslice(offset, 2).unpack1(u16)
      (0...count).each_with_object({}) do |i, found|
        tag, type, n, raw = tiff.byteslice(offset + 2 + 12 * i, 12).unpack("#{u16}#{u16}#{u32}a4")
        name = tags[tag] or next
        size = TYPE_SIZES[type].to_i * n
        bytes = size <= 4 ? raw : tiff.byteslice(raw.unpack1(u32), size)
        found[name] = decode(bytes, type, n, u16, u32, s32)
      end
    end

    ifd0 = read_ifd.call(tiff.byteslice(4, 4).unpack1(u32), IFD0_TAGS)
    exif = ifd0[:exif_ifd] ? read_ifd.call(ifd0[:exif_ifd], EXIF_TAGS) : {}
    gps = ifd0[:gps_ifd] ? read_ifd.call(ifd0[:gps_ifd], GPS_TAGS) : {}
    ifd0.merge(exif).merge(gps)
  end

  def decode(bytes, type, count, u16, u32, s32)
    value =
      case type
      when 2 then bytes.sub(/\0.*\z/m, '').strip
      when 3 then bytes.unpack("#{u16}*").first(count)
      when 4 then bytes.unpack("#{u32}*").first(count)
      when 5 then bytes.unpack("#{u32}*").each_slice(2).map { |n, d| d.zero? ? nil : Rational(n, d) }
      when 10 then bytes.unpack("#{s32}*").each_slice(2).map { |n, d| d.zero? ? nil : Rational(n, d) }
      else bytes
      end
    value.is_a?(Array) && value.size == 1 ? value.first : value
  end
end

def die(message)
  warn "add-photo: #{message}"
  exit 1
end

def which(tool)
  ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).any? { |dir| File.executable?(File.join(dir, tool)) }
end

def run(*command)
  system(*command, out: File::NULL) or die("#{command.first} failed")
end

# Camera as "Make Model", without repeating the make when the model already contains it
def camera_name(exif)
  make = exif[:make].to_s.sub(/\s*\b(corporation|corp\.?|imaging|co\.?,?\s*ltd\.?)/i, '').strip
  model = exif[:model].to_s.strip
  return model if model.downcase.include?(make.downcase) && !model.empty?

  make = make.capitalize if make == make.upcase
  [make, model].reject(&:empty?).join(' ')
end

def number(value, digits = 1)
  value = value.round(digits)
  value == value.to_i ? value.to_i : value.to_f
end

def shutter_speed(seconds)
  return nil unless seconds.is_a?(Rational) && seconds.positive?

  seconds < 1 ? "1/#{(1 / seconds).round}" : number(seconds).to_s
end

def exif_fields(exif)
  iso = exif[:iso].is_a?(Array) ? exif[:iso].first : exif[:iso]
  {
    'camera' => camera_name(exif),
    'lens' => exif[:lens],
    'focal_length' => exif[:focal_length].is_a?(Rational) ? number(exif[:focal_length]) : nil,
    'aperture' => exif[:f_number].is_a?(Rational) ? number(exif[:f_number]) : nil,
    'shutter_speed' => shutter_speed(exif[:exposure_time]),
    'iso' => iso
  }.reject { |_, v| v.nil? || v.to_s.empty? }
end

# Removes everything but the image and the colour profile (EXIF, GPS position, XMP, ...) from
# a JPEG: the position of a photo is a matter for `--location`, not for whoever downloads it.
def strip_metadata(path)
  data = File.binread(path)
  out = data.byteslice(0, 2)
  pos = 2
  while pos + 4 <= data.bytesize && data.getbyte(pos) == 0xFF
    marker = data.getbyte(pos + 1)
    if marker == 0xDA
      out << data.byteslice(pos..)
      break
    end

    length = data.byteslice(pos + 2, 2).unpack1('n')
    segment = data.byteslice(pos, 2 + length)
    keep = !((0xE1..0xEF).cover?(marker) || marker == 0xFE) || segment.include?('ICC_PROFILE'.b)
    out << segment if keep
    pos += 2 + length
  end
  File.binwrite(path, out)
end

# [latitude, longitude] in decimal degrees from the GPS tags, if the photo is geotagged
def gps_position(exif)
  coordinates = %i[lat lon].map do |axis|
    degrees, minutes, seconds = exif[axis]
    next nil unless [degrees, minutes, seconds].all?(Rational)

    value = (degrees + minutes / 60 + seconds / 3600).to_f
    %w[S W].include?(exif[:"#{axis}_ref"]) ? -value : value
  end
  coordinates.all? ? coordinates : nil
end

# "City, Country" for a position, through OpenStreetMap's Nominatim (this sends the
# coordinates to openstreetmap.org); nil when the lookup fails
def place_name(latitude, longitude)
  uri = URI('https://nominatim.openstreetmap.org/reverse')
  uri.query = URI.encode_www_form(format: 'jsonv2', zoom: 12, lat: latitude, lon: longitude, 'accept-language': 'en')
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: true, open_timeout: 5, read_timeout: 10) do |http|
    http.get(uri.request_uri, 'User-Agent' => 'espositoandrea.github.io add-photo script')
  end
  return nil unless response.is_a?(Net::HTTPSuccess)

  address = JSON.parse(response.body)['address'] || {}
  local = address.values_at('city', 'town', 'village', 'municipality', 'suburb', 'county', 'state').compact.first
  [local, address['country']].compact.uniq.join(', ').then { |name| name.empty? ? nil : name }
rescue StandardError
  nil
end

# A single scalar the way it goes in the YAML file
def scalar(value)
  return value.to_s if value.is_a?(Numeric)
  return value if value.match?(%r{\A/[\w./-]+\z}) # paths are fine unquoted

  YAML.dump(value.to_s.gsub(/\s+/, ' ').strip).sub(/\A--- ?/, '').sub(/\n(\.\.\.\n)?\z/, '')
end

def entry_yaml(entry)
  lines = []
  entry.each do |key, value|
    next if value.nil? || value.to_s.empty?

    if value.is_a?(Hash)
      lines << "  #{key}:"
      value.each { |k, v| lines << "    #{k}: #{scalar(v)}" }
    elsif key == 'date'
      lines << "  date: #{value}"
    else
      lines << "  #{key}: #{scalar(value)}"
    end
  end
  lines[0] = "- #{lines[0].lstrip}"
  "#{lines.join("\n")}\n"
end

options = { max_size: 1800, quality: 80, exif: {}, gps: true }
parser = OptionParser.new do |o|
  o.banner = "Usage: #{File.basename($PROGRAM_NAME)} PHOTO [options]"
  o.separator 'Compresses PHOTO (JPEG, TIFF or HEIC) into assets/images/photography/ and adds it to'
  o.separator '_data/photography.yml, filling in the EXIF data. Options override what is in the file.'
  o.separator ''
  o.separator 'Details:'
  o.on('-a', '--alt TEXT', 'What the photo shows, for screen readers (asked for when missing)') { |v| options[:alt] = v }
  o.on('-t', '--title TEXT', 'Title') { |v| options[:title] = v }
  o.on('-c', '--caption TEXT', 'Caption, in Markdown') { |v| options[:caption] = v }
  o.on('-l', '--location TEXT', 'Where it was taken, e.g. "Nice, France"') { |v| options[:location] = v }
  o.on('--[no-]gps', 'Look the location up from the photo\'s GPS tags (default: yes, if no --location)') { |v| options[:gps] = v }
  o.on('-d', '--date DATE', 'YYYY-MM-DD or "YYYY-MM-DD HH:MM:SS" (default: EXIF capture date)') { |v| options[:date] = v }
  o.on('-i', '--instagram URL', 'Link to the Instagram post') { |v| options[:instagram] = v }
  o.separator ''
  o.separator 'EXIF overrides:'
  o.on('--camera TEXT') { |v| options[:exif]['camera'] = v }
  o.on('--lens TEXT') { |v| options[:exif]['lens'] = v }
  o.on('--focal-length MM', Float) { |v| options[:exif]['focal_length'] = number(v) }
  o.on('--aperture F', Float) { |v| options[:exif]['aperture'] = number(v) }
  o.on('--shutter-speed TEXT', 'e.g. 1/250') { |v| options[:exif]['shutter_speed'] = v }
  o.on('--iso N', Integer) { |v| options[:exif]['iso'] = v }
  o.separator ''
  o.separator 'Output:'
  o.on('-s', '--slug TEXT', 'File name (default: from the title, or the original name)') { |v| options[:slug] = v }
  o.on('-m', '--max-size PX', Integer, "Longest side in pixels (default: #{options[:max_size]})") { |v| options[:max_size] = v }
  o.on('-q', '--quality N', Integer, "JPEG quality, 1-100 (default: #{options[:quality]})") { |v| options[:quality] = v }
  o.on('-f', '--force', 'Overwrite an existing file of the same name') { options[:force] = true }
  o.on('-n', '--dry-run', 'Show the YAML entry without writing anything') { options[:dry_run] = true }
  o.on('-h', '--help') do
    puts o
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  die("#{e.message}\n#{parser}")
end
die(parser.to_s) unless ARGV.size == 1

source = File.expand_path(ARGV.first)
die("#{source}: no such file") unless File.file?(source)
die("#{File.extname(source)}: unsupported format (use #{INPUT_FORMATS.join(', ')})") unless INPUT_FORMATS.include?(File.extname(source).downcase)
die('--quality must be between 1 and 100') unless (1..100).cover?(options[:quality])

tool = if which('sips') then :sips elsif which('magick') then :magick end
die('needs sips (macOS) or ImageMagick (magick) to convert the photo') unless tool

Tempfile.create(['add-photo', '.jpg']) do |tmp|
  tmp.close
  # Orientation is read before conversion, to rotate the pixels if the converter does not
  exif = Exif.read(source)
  large = options[:max_size]

  if tool == :sips
    run('sips', '-s', 'format', 'jpeg', '-s', 'formatOptions', options[:quality].to_s, source, '--out', tmp.path)
    exif = Exif.read(tmp.path) if exif.empty? # HEIC: the EXIF data survives the conversion
    size = `sips -g pixelWidth -g pixelHeight #{tmp.path.shellescape}`.scan(/pixel(?:Width|Height): (\d+)/).flatten.map(&:to_i)
    run('sips', '--resampleHeightWidthMax', large.to_s, tmp.path) if size.max > large
    # sips keeps the orientation tag without applying it: bake it into the pixels
    flip = { 2 => ['-f', 'horizontal'], 3 => ['-r', '180'], 4 => ['-f', 'vertical'],
             5 => ['-r', '90', '-f', 'horizontal'], 6 => ['-r', '90'],
             7 => ['-r', '270', '-f', 'horizontal'], 8 => ['-r', '270'] }[Exif.read(tmp.path)[:orientation]]
    run('sips', *flip, tmp.path) if flip
  else
    run('magick', source, '-auto-orient', '-resize', "#{large}x#{large}>", '-quality', options[:quality].to_s, tmp.path)
    exif = Exif.read(source) if exif.empty?
  end
  strip_metadata(tmp.path)

  date = options[:date] ||
         (exif[:date_time] && exif[:date_time].sub(/\A(\d{4}):(\d\d):(\d\d)/, '\1-\2-\3')) ||
         (warn('add-photo: no capture date in the photo, using its modification time') || File.mtime(source).strftime('%Y-%m-%d %H:%M:%S'))
  begin
    day = Date.parse(date.to_s[0, 10])
  rescue Date::Error
    die("#{date}: not a valid date")
  end

  alt = options[:alt]
  if alt.nil? && $stdin.tty?
    $stderr.print 'Alt text (what the photo shows): '
    alt = $stdin.gets.to_s.strip
  end
  warn('add-photo: no alt text; fill in `alt` in _data/photography.yml') if alt.to_s.empty?

  base = options[:slug] || options[:title] || File.basename(source, '.*')
  slug = base.downcase.gsub(/[^a-z0-9]+/, '-').gsub(/\A-|-\z/, '').sub(/\.jpe?g\z/, '')
  slug = slug.sub(/\A\d{4}-\d\d-/, '') # the date prefix is added below
  die('cannot make a file name out of that: use --slug') if slug.empty?
  name = "#{day.strftime('%Y-%m')}-#{slug}.jpg"
  relative = File.join(PHOTO_DIR, name)
  destination = File.join(ROOT, relative)
  die("#{relative} already exists (use --force to overwrite, or --slug to rename)") if File.exist?(destination) && !options[:force]

  yaml_text = File.read(DATA_FILE)
  die("#{relative} is already listed in photography.yml") if yaml_text.include?("/#{relative}") && !options[:force]

  location = options[:location]
  if location.nil? && options[:gps] && (position = gps_position(exif))
    location = place_name(*position)
    warn(location ? "add-photo: location from GPS: #{location}" : "add-photo: photo is geotagged (#{position.map { |c| c.round(5) }.join(', ')}) but the place lookup failed; use --location")
  end

  entry = {
    'image' => "/#{relative}",
    'alt' => alt.to_s,
    'date' => date,
    'title' => options[:title],
    'caption' => options[:caption],
    'location' => location,
    'exif' => exif_fields(exif).merge(options[:exif]).slice('camera', 'lens', 'focal_length', 'aperture', 'shutter_speed', 'iso'),
    'instagram' => options[:instagram]
  }
  entry.delete('exif') if entry['exif'].empty?
  text = entry_yaml(entry)

  # The data file starts out as an empty list (`[]`) below its comments
  updated = if yaml_text.match?(/^\[\]\s*$/)
              yaml_text.sub(/^\[\]\s*$/) { text }
            else
              yaml_text.chomp << "\n" << text
            end
  begin
    list = YAML.safe_load(updated, permitted_classes: [Date, Time])
    die('the entry does not produce a valid list in photography.yml') unless list.is_a?(Array) && list.last['image'] == "/#{relative}"
  rescue Psych::Exception => e
    die("the result would not be valid YAML: #{e.message}")
  end

  size_kb = (File.size(tmp.path) / 1024.0).round
  if options[:dry_run]
    puts "# would write #{relative} (#{size_kb} KB)"
    puts text
  else
    FileUtils.mkdir_p(File.dirname(destination))
    FileUtils.cp(tmp.path, destination)
    File.write(DATA_FILE, updated)
    puts "Wrote #{relative} (#{size_kb} KB) and added to _data/photography.yml:\n\n#{text}"
  end
end
